{
  "name": "monitorimi",
  "version": "1.0.0",
  "main": "build/app.js",
  "scripts": {
    "build": "tsc && npm run copy-locales",
    "copy-locales": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('app','i18n','locales'),d=p.join('build','i18n','locales');fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s).filter(f=>f.endsWith('.json')))fs.copyFileSync(p.join(s,f),p.join(d,f));\"",
    "start": "nodemon --ignore uploads/ --exec \"npm run build && node build/app.js\"",
    "dev": "nodemon --exec ts-node app/app.ts",
    "i18n:check": "node app/i18n/validate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
